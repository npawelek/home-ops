{
  "mcpServers": {
    "flux-operator-mcp": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "flux-operator-mcp",
        "serve",
        "--read-only"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "mcp-grafana",
        "--disable-incident",
        "--disable-alerting",
        "--usage-stats=disabled",
        "--disable-oncall"
      ]
    },
    "home-assistant": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "ha-mcp"
      ]
    },
    "trek": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "sh",
        "-c",
        "exec mcp-remote \"https://trek.${SECRET_DOMAIN}/mcp\""
      ]
    },
    "unifi-network": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "sh",
        "-c",
        "UNIFI_NETWORK_HOST=\"udmp.${SECRET_DOMAIN}\" exec unifi-network-mcp"
      ],
      "env": {
        "UNIFI_NETWORK_CONTROLLER_TYPE": "proxy",
        "UNIFI_NETWORK_VERIFY_SSL": "true",
        "UNIFI_POLICY_NETWORK_CREATE": "false",
        "UNIFI_POLICY_NETWORK_UPDATE": "false",
        "UNIFI_POLICY_NETWORK_DELETE": "false",
        "UNIFI_TOOL_REGISTRATION_MODE": "eager"
      }
    }
  }
}
