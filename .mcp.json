{
  "mcpServers": {
    "flux-operator-mcp": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "flux-operator-mcp",
        "serve",
        "--read-only"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "mcp-grafana",
        "--disable-incident",
        "--disable-alerting",
        "--usage-stats=disabled",
        "--disable-oncall"
      ]
    },
    "home-assistant": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "ha-mcp"
      ]
    },
    "trek": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "x",
        "--",
        "sh",
        "-c",
        "exec mcp-remote \"https://trek.${SECRET_DOMAIN}/mcp\""
      ]
    }
  }
}
