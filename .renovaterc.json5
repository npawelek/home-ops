{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  separateMultipleMajor: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  pip_requirements: {
    managerFilePatterns: ["/(^|/)requirements\\.txt$/"],
  },
  "pre-commit": {
    enabled: true,
    managerFilePatterns: ["/(^|/)\\.pre-commit-config\\.ya?ml$/"],
  },
  packageRules: [
    {
      description: "Separate authentik Terraform provider updates from Helm chart updates",
      matchManagers: ["terraform"],
      matchPackageNames: ["goauthentik/authentik"],
      groupName: "authentik-terraform-provider",
    },
    {
      description: "Separate Immich Valkey into its own Renovate group to decouple from shared valkey upgrades",
      matchDatasources: ["docker"],
      matchPackageNames: ["valkey/valkey"],
      matchFileNames: ["kubernetes/apps/immich/redis/**"],
      groupName: "immich-valkey",
    },
    {
      description: "Keep talosVersion (talos/topf.yaml) and the talosctl mise pin on one PR — they must match",
      matchPackageNames: ["/siderolabs/talos$/"],
      groupName: "talos",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "jellyfin versioning changed from X.Y.Z (10.x) to X.Y.YYYYMMDD-HHMMSS (12.x)",
      matchDatasources: ["docker"],
      matchPackageNames: ["jellyfin/jellyfin"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-\\d+)?$",
    },
    {
      description: "SearXNG date-based tag versioning",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-.*$",
    },
    {
      description: "cnpg-vchord PG-pinned versioning (image tag only; the immich Database CR tracks the extracted X.Y.Z with default versioning)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jdijt/cnpg-vchord"],
      matchFileNames: ["kubernetes/apps/database/postgres/app/**"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-\\d+-\\d+-\\w+$",
    },
    {
      description: "vchord: image (postgres/app/cluster.yaml) and immich Database CR version move in one PR; CNPG runs ALTER EXTENSION UPDATE TO",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jdijt/cnpg-vchord"],
      groupName: "vchord",
      automerge: false,
      prBodyNotes: [
        "{{#unless (equals updateType 'digest')}}⚠️ vchord is preloaded; the `postgres` cluster restarts on this change. CNPG then runs `ALTER EXTENSION vchord UPDATE TO` in `immich` from the Database CR `version` (failures retry every 30s; see `kubectl -n database get database immich -o yaml` status). Check the VectorChord release notes for required reindexing. Verify with `select e.extname, e.extversion, coalesce(a.default_version, 'MISSING') from pg_extension e left join pg_available_extensions a on a.name = e.extname where a.default_version is distinct from e.extversion;` (expect no rows). Run it with `psql -d immich`.{{/unless}}",
      ],
    },
    {
      description: "pgvector: image (postgres/app/cluster.yaml) and immich Database CR version move in one PR; CNPG runs ALTER EXTENSION UPDATE TO",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgvector"],
      groupName: "pgvector",
      automerge: false,
      prBodyNotes: [
        "{{#unless (equals updateType 'digest')}}ℹ️ After the `postgres` cluster rolls, CNPG runs `ALTER EXTENSION vector UPDATE TO` in `immich` from the Database CR `version` (failures retry every 30s; see `kubectl -n database get database immich -o yaml` status). Verify with `select e.extname, e.extversion, coalesce(a.default_version, 'MISSING') from pg_extension e left join pg_available_extensions a on a.name = e.extname where a.default_version is distinct from e.extversion;` (expect no rows). Run it with `psql -d immich`.{{/unless}}",
      ],
    },
    {
      description: "postgis: image (postgres/app/cluster.yaml) and dawarich Database CR version move in one PR; CNPG runs ALTER EXTENSION UPDATE TO",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgis-extension"],
      groupName: "postgis",
      automerge: false,
      prBodyNotes: [
        "{{#unless (equals updateType 'digest')}}ℹ️ After the `postgres` cluster rolls, CNPG runs `ALTER EXTENSION postgis UPDATE TO` in `dawarich` from the Database CR `version` (failures retry every 30s; see `kubectl -n database get database dawarich -o yaml` status). Verify with `select e.extname, e.extversion, coalesce(a.default_version, 'MISSING') from pg_extension e left join pg_available_extensions a on a.name = e.extname where a.default_version is distinct from e.extversion;` (expect no rows). Run it with `psql -d dawarich`.{{/unless}}",
      ],
    },
    {
      description: "timescaledb-ha pgMAJOR.MINOR-tsX.Y.Z tags; PG major pinned via compatibility, TimescaleDB drives semver, PG minor as build",
      matchDatasources: ["docker"],
      matchPackageNames: ["timescale/timescaledb-ha"],
      versioning: "regex:^pg(?<compatibility>\\d+)\\.(?<build>\\d+)-ts(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      automerge: false,
      prBodyNotes: [
        "{{#unless (equals updateType 'digest')}}⚠️ After the `timescale` cluster rolls, run `ALTER EXTENSION timescaledb UPDATE;` then `ALTER EXTENSION timescaledb_toolkit UPDATE;` in a fresh `psql -X -d tracearr` session on the primary. See `kubernetes/apps/database/timescale/README.md`.{{/unless}}",
      ],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Mise Tools Manual Review",
      matchManagers: ["mise"],
      automerge: false,
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge Renovate CLI (pre-commit validator); releases near-daily",
      matchManagers: ["mise"],
      matchPackageNames: ["renovate", "npm:renovate"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "iptv-org/epg only publishes :master with site scrapers baked in; auto-merge digest bumps to pick up upstream scraper fixes",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/iptv-org/epg"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "2 days",
    },
    {
      description: "Node runs only npm:renovate; hold to Renovate's engines range (^24.11.0)",
      matchManagers: ["mise"],
      matchPackageNames: ["node"],
      allowedVersions: "<25",
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
  customManagers: [
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/\\.yaml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process CNPG Cluster imageName fields",
      managerFilePatterns: [
        "/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "imageName:\\s+(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process CNPG extension image reference fields",
      managerFilePatterns: [
        "/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "reference:\\s+(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update app-template schema version in yaml-language-server comments",
      managerFilePatterns: [
        "/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "\\$schema=https://raw\\.githubusercontent\\.com/bjw-s/helm-charts/app-template-(?<currentValue>[^/]+)/charts/other/app-template/schemas/helmrelease-helm-v2\\.schema\\.json",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/bjw-s-labs/helm/app-template",
    },
  ],
}
