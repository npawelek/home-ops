      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "All syslog lines for the selected devices, narrowed by the Filter regex (case-insensitive). Log details carry host_name, severity, facility, and for UniFi switches/APs unifi_mac, unifi_model and unifi_firmware.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |~ `(?i)${filter}`",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "id": 11,
      "panels": [],
      "title": "Errors & Warnings",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Syslog lines at warning severity or worse for the selected devices.",
      "gridPos": {
