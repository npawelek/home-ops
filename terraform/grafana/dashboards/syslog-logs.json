      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Syslog from off-cluster devices (UniFi gateway/switches/APs, Synology) received by the OTel gateway on 1514 tcp/udp \u2014 volume, firewall drops, and interactive filtering by device.",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Rate",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Log lines per interval by device, stacked. service_name is the syslog appname, or the hostname when the device sends none (UDM-Pro) or a UniFi '<mac>,<model>-<fw>' appname \u2014 so UniFi devices group by model. Use the unifi_mac field in log details to tell same-model devices apart. A device vanishing means it stopped sending or lost its SIEM config.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |~ `(?i)${filter}` [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Device",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 13,
      "panels": [],
      "title": "Errors",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Lines at warning severity or worse (warning, err, crit, alert, emerg), by device. Healthy: near zero. UDM firewall drop lines are notice-level and excluded here.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"syslog\", service_name=~\"${device:regex}\"} | severity_text =~ `(?i)warn.*|err.*|crit.*|alert|emerg.*|fatal` |~ `(?i)${filter}` [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Warning+ Rate by Device",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 4,
      "panels": [],
      "title": "Firewall",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "UniFi CEF \"Blocked by Firewall\" events (Flow Logging: Blocked Traffic Only), by firewall policy and direction. \"drop all (implicit)\" with direction=incoming is the WAN default drop \u2014 internet scan noise is normal here. The UDM also emits kernel-style \"[LAN_LOCAL-RET-...]\" lines for the Firewall Default Policy content; those are excluded from this row (browse them below).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum by (policy, direction) (count_over_time({service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |= `UNIFIpolicyName=` |~ `(?i)${filter}` | regexp `UNIFIpolicyName=(?P<policy>.+?) UNIFIpolicyType=` | regexp `UNIFIdirection=(?P<direction>\\S+)` [$__auto]))",
          "legendFormat": "{{policy}} ({{direction}})",
          "refId": "A"
        }
      ],
      "title": "Blocked Flows by Policy",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Top 15 direction / protocol / destination-port combinations among blocked flows across the selected time range. ICMP has no ports and is excluded. Look for the WireGuard listen port on an incoming row.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "topk(15, sum by (direction, proto, dpt) (count_over_time({service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |= `UNIFIpolicyName=` |~ `(?i)${filter}` | regexp `proto=(?P<proto>\\S+) spt=\\d+ dpt=(?P<dpt>\\d+)` | regexp `UNIFIdirection=(?P<direction>\\S+)` [$__range])))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Destination Ports",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Top 15 blocked source addresses with their GeoIP region across the selected time range. A US mobile-carrier address blocked on an incoming row while the VPN was failing points at the UDM dropping WireGuard traffic.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "topk(15, sum by (src, src_region, direction) (count_over_time({service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |= `UNIFIpolicyName=` |~ `(?i)${filter}` | regexp `src=(?P<src>\\S+) dst=\\S+ UNIFIsrcRegion=(?P<src_region>\\S+)` | regexp `UNIFIdirection=(?P<direction>\\S+)` [$__range])))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Sources",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Blocked flows with direction=incoming \u2014 traffic from the internet that the UDM dropped, including WireGuard clients if they are being blocked. Set Filter to e.g. dpt=<wg-port> to isolate VPN traffic.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{service_namespace=\"syslog\", service_name=~\"${device:regex}\"} |= `UNIFIdirection=incoming` |~ `(?i)${filter}`",
          "refId": "A"
        }
      ],
      "title": "Inbound Blocks",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "id": 9,
      "panels": [],
