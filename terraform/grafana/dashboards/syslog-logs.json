          },
          "expr": "{service_namespace=\"syslog\", service_name=~\"${device:regex}\"} | severity_text =~ `(?i)warn.*|err.*|crit.*|alert|emerg.*|fatal` |~ `(?i)${filter}`",
          "refId": "A"
        }
      ],
      "title": "Warning+ Logs",
      "type": "logs"
    }
  ],
